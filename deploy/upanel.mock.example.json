{
  "web": {
    "mode": "mock",
    "listen_address": "127.0.0.1:18881",
    "shutdown_timeout_seconds": 10
  },
  "agent": {
    "socket_path": "/run/upanel/agent.sock",
    "shutdown_timeout_seconds": 10
  },
  "database": {
    "path": "/var/lib/upanel/upanel-mock.db",
    "busy_timeout_ms": 5000
  },
  "log": {
    "level": "debug",
    "format": "text",
    "add_source": false
  }
}
