# P04.1 实际执行的命令（按时间顺序，脱敏后）

## 宿主（Windows 11 + Git Bash，Go 1.27.3 / Node 22.23.3）

    export PATH="/c/Program Files/Go/bin:$PATH"
    export PATH="/c/Users/huxi/AppData/Local/nvm/v22.23.3:$PATH"

    go build ./...                                   # exit 0
    go vet ./...                                     # exit 0
    gofmt -l .                                       # 无输出
    go test -count=1 ./...                           # 19 个包 ok，exit 0
    go test -count=1 -v ./internal/monitoring/ ./internal/agent/ ./internal/api/   # --- PASS 228 / FAIL 0
    sh scripts/check.sh                              # PASS 12 / FAIL 0 / NOT RUN 0
    npx --yes @redocly/cli@1.34.5 lint --format=summary api/openapi.yaml            # valid, 9 warnings

交叉编译（验收 VM 用）。实际部署的那一批是 2026-10-20T16:49:29Z 构建的：

    export GOOS=linux GOARCH=amd64 CGO_ENABLED=0
    V=0.0.0-p04.1; C=6f5e6bb; D=2026-10-20T16:49:29Z
    for b in upanel-web upanel-agent upanelctl; do
      go build -trimpath -ldflags "-X upanel/internal/version.Version=$V \
        -X upanel/internal/version.Commit=$C -X upanel/internal/version.BuildDate=$D" \
        -o dist/linux-amd64/$b ./cmd/$b
    done
    for p in agent agentclient agentstore api monitoring operations store syscmd; do
      go test -c -o dist/linux-amd64/tests/$p.test ./internal/$p
    done
    sha256sum dist/linux-amd64/upanel-* dist/linux-amd64/tests/*.test   # 见 cross-build-sha256.txt

    # 复核：把 BUILD_DATE 固定成二进制 -version 打印的那个值后重编三个入口，
    # sha256 与部署的那份逐个相同（f8c47d8b… / 2b6d0a06… / 42a763f6…）；
    # 测试二进制不带 -trimpath 才与 VM 上的那份一致（见 cross-build-sha256.txt 注释）。

上传到两台 VM（Git Bash 的 ssh；PowerShell 的 ssh 不认这两把私钥）：

    scp -i /h/Code/vms/upanel-2404/id_ed25519 -P 2222 dist/linux-amd64/upanel-* upanel@127.0.0.1:/tmp/upanel-bin/
    scp -i /h/Code/vms/upanel-2404/id_ed25519 -P 2222 dist/linux-amd64/tests/*.test upanel@127.0.0.1:/tmp/upanel-bin/tests/
    scp -i /h/Code/vms/upanel-2404/id_ed25519 -P 2222 tests/integration/*.sh upanel@127.0.0.1:/tmp/upanel-src/tests/integration/
    scp -i /h/Code/vms/upanel-2404/id_ed25519 -P 2222 tests/fixtures/* upanel@127.0.0.1:/tmp/upanel-src/tests/fixtures/
    scp -i /h/Code/vms/upanel-2404/id_ed25519 -P 2222 scripts/run-native-tests.sh upanel@127.0.0.1:/tmp/run-native-tests.sh
    scp -i /h/Code/vms/upanel-2404/id_ed25519 -P 2222 -r deploy upanel@127.0.0.1:/tmp/upanel-src/
    ssh ... 'chmod 0755 /tmp/upanel-bin/upanel-web /tmp/upanel-bin/upanel-agent /tmp/upanel-bin/upanelctl /tmp/upanel-bin/tests/*.test'
    # 22.04 同一条命令，端口 2223、密钥 upanel-2204
    # 夹具同时拷到 /tmp/upanel-bin/fixtures（测试二进制按“二进制旁边的 fixtures”查找，
    # 见 internal/testsupport/fixtures.go）

sha256 逐字节核对（11 个文件：三个入口 + 8 个测试二进制，两台 VM 与宿主逐个一致）：

    tar cf - upanel-web upanel-agent upanelctl tests | ssh ... 'cd /tmp/upanel-bin && tar xf -'
    ssh ... 'cd /tmp/upanel-bin && sha256sum upanel-web upanel-agent upanelctl tests/*.test'
    # 原始输出：vm-sha256-2404.txt、vm-sha256-2204.txt（本轮先发现 22.04 的 api.test 还是旧产物
    # 8cf56ce6…，重新同步 11 个文件后一致；原生测试在同步后重跑）

## 验收 VM 内（VM-B 24.04.5 / VM-A 22.04.5，均以 root 执行）

    # 单脚本（P04.1 本阶段验收）
    sudo BIN_DIR=/tmp/upanel-bin sh /tmp/upanel-src/tests/integration/p04-1-system-acceptance.sh

    # VM 内核上的 Go 测试二进制（含 monitoring 包）
    sudo BIN_DIR=/tmp/upanel-bin sh /tmp/upanel-src/run-native-tests.sh

    # 全量回归（12 个脚本，按脚本头声明的身份调度）
    sudo BIN_DIR=/tmp/upanel-bin LOG_DIR=/var/tmp/upanel-logs-p041c \
      sh /tmp/upanel-src/tests/integration/run-all.sh

    # 环境事实采集
    lsb_release -ds; uname -r; nproc; free -b; ip -br addr; python3 -V
    command -v go   # 未安装（DECISIONS Q9）

## 环境事故（不是产品行为）

    # 24.04 验收 VM 在本轮开始前第四次内核 panic（P02.4、P03.2 各一次，P03.4 一次，本轮一次；
    # 四次全在 24.04，22.04 一次没有）：
    #   ---[ end Kernel panic - not syncing: Attempted to kill init! exitcode=0x0000008b ]---
