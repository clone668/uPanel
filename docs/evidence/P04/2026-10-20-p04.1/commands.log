    #       powershell -File H:\Code\vms\launch-vm.ps1 -Name upanel-2404 -SshPort 2222 -SeedPort 8899
    #       → /tmp 与 /etc/upanel/upanel.json 已被写坏/清空 → 重新上传二进制、脚本、夹具，
