```sh
export PATH="/h/Code/go/bin:/c/Program Files/Go/bin:/h/Code/.toolchains/node-v22.23.3-win-x64:$PATH"

go version                                    # go1.27.3 windows/amd64
go build ./...                                # exit 0  → go-gates.txt
