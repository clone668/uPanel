```
ssh … 'sudo tar -c -C /var/tmp/upanel-accept-p05-3 payloads live.frames resume.frames idle.frames' \
  | tar -x -C docs/evidence/P05/2026-10-21-p05.3
cp docs/evidence/P05/2026-10-21-p05.3/payloads/*.json web/src/fixtures/p05-3-vm/
cp docs/evidence/P05/2026-10-21-p05.3/*.frames    web/src/fixtures/p05-3-vm/*.frames.txt
