## 5. 等待 SSH 就绪（Git Bash）

for i in $(seq 1 40); do ssh -i id_ed25519 -o BatchMode=yes -p 2222 upanel@127.0.0.1 true && break; sleep 5; done
# 结果: 端口 2222 约 10s 内就绪；退出码 0
# 同法验证 2223 -> 约 5s 内就绪；退出码 0

## 6. VM 内核验（命令全文见 vm-2404-verification.txt / vm-2204-verification.txt）

ssh -i id_ed25519 -p 2222 upanel@127.0.0.1 '<第 3 节核验脚本>' > vm-2404-verification.txt
ssh -i id_ed25519 -p 2223 upanel@127.0.0.1 '<第 3 节核验脚本>' > vm-2204-verification.txt
# 结果: 输出写入证据文件；退出码 0

## 7. 宿主侧隔离核验（PowerShell）

Get-Disk | Select Number,FriendlyName,SerialNumber,@{n='SizeGB';e={$_.Size/1GB}},BusType
Get-CimInstance Win32_Process -Filter "Name='qemu-system-x86_64.exe'" | Select ProcessId,CommandLine
Get-ChildItem H:\Code\vms -Recurse -Filter *.qcow2
Get-NetTCPConnection -State Listen | Where LocalPort -in 2222,2223,8899,8900
Get-ChildItem H:\Code\uPanel -Recurse -Include *.qcow2,*.vdi,*.vmdk,*.iso
# 结果: 见 host-isolation.txt；退出码 0

## 8. 关闭与清理

ssh -i id_ed25519 -p 2222 upanel@127.0.0.1 'sudo systemctl poweroff'
ssh -i id_ed25519 -p 2223 upanel@127.0.0.1 'sudo systemctl poweroff'
# 结果: VM 关机；退出码 0（SSH 连接随关机断开，属预期）
# 清理: 停止 8899 / 8900 的 seed HTTP 服务
