# 构建产物与本地文件
/web/node_modules/
# 仓库根的 node_modules：openapi lint（redocly）装在仓库根时用的，不入库
/node_modules/
/web/dist/
/web/dist-mock/
/internal/webui/dist/*
!/internal/webui/dist/.keep
/web/coverage/
/web/.vite/
/web/test-results/
/web/playwright-report/
/web/blob-report/

# 数据库与运行时数据（本机调试用，不提交）
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/tmp/
/var/

# 二进制与发布包
/bin/
/dist/
/.build/
*.exe
*.test
*.out
*.tar.gz
*.zip

# 例外：证据目录里的 *.out 是**真机读数**（纯文本命令输出），不是编译产物。
# 上面那条 `*.out` 本来是拦 Go 测试二进制的，结果把
# docs/evidence/P14/…/facts/ssh-bob-*.out、P12/…/wait-timeout.out 这类读数一起吞了——
# 文档里引用它们，仓库里却没有，验收链就断了。只对 .out 开例外：
# .key/.pem/.db 仍然一律不进来（测试机上的密钥、库副本不该进仓库）。
!/docs/evidence/**/*.out

# 秘密与本地配置
.env
.env.*
*.pem
*.key
!web/node_modules/**/*.key
!/docs/**/*.key.example
secrets/

# 测试磁盘镜像与 VM 证据（绝不入库）
*.qcow2
*.vdi
*.vmdk
*.iso
*.raw

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 交叉编译产物（P02.3 起的 VM 验收用）
/.tmp-linux-bin/

# 本机临时产物（构建缓存、运行日志、临时目录）
/.tmp/
# P10.4 起验收夹具用的临时目录（脚本、原始 JSON、复制回来的日志）
/.tmp-*/
