{
  "name": "upanel-web",
  "private": true,
  "version": "0.0.0",
  "description": "uPanel 前端（Vue 3 + TypeScript）。P00 只冻结依赖版本与锁文件，应用骨架在 P01.3 建立。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mock": "node scripts/smoke.mjs --mock"
  },
  "engines": {
    "node": ">=22.23.3 <23",
    "npm": ">=10.9.9 <11"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "echarts": "6.1.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.65.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
